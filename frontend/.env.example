# Frontend environment configuration (placeholders only - do not commit real secrets)
# API Base URL (defaults to /api/v1, proxied through Vite to FastAPI backend on port 8000)
VITE_API_BASE_URL=/api/v1

# Supabase Auth Configuration (Publishable anon key only - NEVER put service role key here!)
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-publishable-anon-key>

# Standalone mock adapter toggle (set to false for FastAPI Live, true for mock adapter)
VITE_USE_MOCK=false
